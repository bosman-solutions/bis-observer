# .env — COLLECTOR NODE CONFIGURATION
#
# Copy to .env before deploying. One copy per node. Never commit it.
#
# This file is deliberately short. Every other setting has a working default
# baked into docker-compose.yml (`${KEY:-default}`), so a node that has never
# heard of a new setting still comes up correctly. Only put a key here when the
# value genuinely differs from machine to machine.
#
# Adding a feature? Give it a default in the compose file, document it in the
# README table, and leave this file alone. See TODO.md → "env defaults live in
# compose" for the reasoning.

# -----------------------------------------------------------------------------
# REQUIRED — the deploy stops if this is unset
# -----------------------------------------------------------------------------

# IP or hostname of the aggregator node this collector ships to.
# Use a stable address — WireGuard or LAN IP, not DNS.
AGGREGATOR_HOST=10.0.0.x

# -----------------------------------------------------------------------------
# TOOL-MANAGED — do not set by hand
# -----------------------------------------------------------------------------

# Label applied to every metric and log line from this node. `make` stamps it
# from the system hostname if unset, via scripts/envset.sh (upsert, no drift).
#NODE_NAME=node-01

# -----------------------------------------------------------------------------
# OVERRIDES — only if you have a conflict
# -----------------------------------------------------------------------------
# All optional. Defaults are in collector/docker-compose.yml; the full list with
# values lives in README.md. Common ones:
#
#   NODE_EXPORTER_PORT     9100    change if something else owns 9100
#   INVENTORY_PORT         9338    docker-inventory exporter
#   AGGREGATOR_PROM_PORT   9090    must match the aggregator
#   AGGREGATOR_LOKI_PORT   3100    must match the aggregator
#
# Kubernetes is not configured here. A cluster is ingested by the aggregator as
# a pull target; the collector stays k8s-free.
