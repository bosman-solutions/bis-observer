    {
      "type": "timeseries",
      "title": "THE DIVERGENCE \u2014 kernel residency vs actual work",
      "description": "The headline. When util rides at 100% while SM_ACTIVE sits far below it, the card is occupied but not working \u2014 the signature of a memory-bound decode loop, a stalled kernel, or a throttled clock. When DRAM_ACTIVE tracks above SM_ACTIVE, the workload is bandwidth-bound and more SMs will not help it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL{node=\"$node\", gpu=~\"$gpu\"}",
          "legendFormat": "gpu {{gpu}} \u2014 util (naive)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "DCGM_FI_PROF_SM_ACTIVE{node=\"$node\", gpu=~\"$gpu\"} * 100",
          "legendFormat": "gpu {{gpu}} \u2014 SM active",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "DCGM_FI_PROF_DRAM_ACTIVE{node=\"$node\", gpu=~\"$gpu\"} * 100",
          "legendFormat": "gpu {{gpu}} \u2014 DRAM active",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{node=\"$node\", gpu=~\"$gpu\"} * 100",
          "legendFormat": "gpu {{gpu}} \u2014 tensor pipe",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "VRAM \u2014 claimed vs capacity",
      "description": "Framebuffer is the scarce parcel. A second tenant fails to load the moment used approaches total, regardless of how idle the card looks.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
