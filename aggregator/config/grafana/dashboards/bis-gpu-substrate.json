    {
      "type": "stat",
      "title": "Throttle reason (live bitmask)",
      "description": "Bit flags \u2014 combinations appear as a raw sum (12 = SW power cap + HW slowdown). Live state; the violation counters above are the durable record.",
      "datasource": {
        "type": "prometheus",
