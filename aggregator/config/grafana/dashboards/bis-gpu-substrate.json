        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * avg_over_time((DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{node=\"$node\", gpu=~\"$gpu\"} > bool 1)[5m:])",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
