          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Clocks \u2014 the throttle story",
      "description": "Clocks falling while load is steady is throttling. This is the invisible noisy neighbour: one tenant's power draw caps another tenant's clocks, and the victim's slowdown looks like its own bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MHz",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK{node=\"$node\", gpu=~\"$gpu\"}",
          "legendFormat": "gpu {{gpu}} \u2014 SM clock",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "DCGM_FI_DEV_MEM_CLOCK{node=\"$node\", gpu=~\"$gpu\"}",
          "legendFormat": "gpu {{gpu}} \u2014 mem clock",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Throttle reason (bitmask)",
      "description": "Bit flags, so combinations show as a raw sum (e.g. 12 = SW power cap + HW slowdown). Nonzero and not 1 means something is being capped right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "None",
                  "color": "green"
                },
                "1": {
                  "text": "GPU idle",
                  "color": "text"
                },
                "2": {
                  "text": "App clocks setting",
                  "color": "yellow"
                },
                "4": {
                  "text": "SW POWER CAP",
                  "color": "orange"
                },
                "8": {
                  "text": "HW SLOWDOWN",
                  "color": "red"
                },
                "32": {
                  "text": "SW THERMAL",
                  "color": "orange"
                },
                "64": {
                  "text": "HW THERMAL",
                  "color": "red"
                },
                "128": {
                  "text": "HW POWER BRAKE",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{node=\"$node\", gpu=~\"$gpu\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Power draw vs enforced limit",
      "description": "Draw pinned to the limit line is the cause; the clock panel above is the effect.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 25,
