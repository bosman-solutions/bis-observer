{
  "uid": "bis-gpu-substrate",
  "title": "BIS \u2014 GPU / AI substrate",
  "tags": [
    "bis",
    "gpu",
    "ai",
    "authored"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Node",
        "query": {
          "query": "label_values(DCGM_FI_DEV_FB_TOTAL, node)",
          "refId": "n"
        },
        "refresh": 2,
        "sort": 1,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "gpu",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "GPU",
        "query": {
          "query": "label_values(DCGM_FI_DEV_FB_TOTAL{node=\"$node\"}, gpu)",
          "refId": "g"
        },
        "refresh": 2,
        "sort": 1,
        "current": {},
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### AI substrate \u2014 device truth\n`DCGM_FI_DEV_GPU_UTIL` (\"GPU utilization\") reports only that **a kernel was resident**, not that the chip did work. A card pinned at 100% util can be nearly idle, and a card at 0% util can be holding gigabytes of model weights that must not be evicted. Every panel below is arranged so the naive number can be checked against a real one: **SM_ACTIVE** for compute, **DRAM_ACTIVE** for memory bandwidth (which is what actually bounds token generation), **FB_USED** for the allocation that decides who gets evicted, and **CLOCK_THROTTLE_REASONS** for the neighbour silently capping someone else's clocks."
      }
    },
    {
      "type": "stat",
      "title": "GPU util (naive)",
      "description": "Kernel residency. Kept on this board as the control series, not as a health signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL{node=\"$node\", gpu=~\"$gpu\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "SM active (real)",
      "description": "Fraction of time at least one warp was resident on an SM. Empty if DCGM profiling is unsupported on this card.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_SM_ACTIVE{node=\"$node\", gpu=~\"$gpu\"} * 100",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DRAM active",
      "description": "Memory bandwidth pressure. Decode is usually bandwidth-bound, so this predicts tokens/sec better than SM_ACTIVE.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_DRAM_ACTIVE{node=\"$node\", gpu=~\"$gpu\"} * 100",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "VRAM claimed",
      "description": "The parcel map. This is the number that decides whether the next model load succeeds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 93
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * DCGM_FI_DEV_FB_USED{node=\"$node\", gpu=~\"$gpu\"} / clamp_min(DCGM_FI_DEV_FB_TOTAL{node=\"$node\", gpu=~\"$gpu\"}, 1)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{gpu}}"
        }
      ]
    },
