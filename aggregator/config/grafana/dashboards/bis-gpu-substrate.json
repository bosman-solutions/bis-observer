        }
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{node=\"$node\", gpu=~\"$gpu\"}",
          "legendFormat": "gpu {{gpu}} \u2014 used",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "DCGM_FI_DEV_FB_TOTAL{node=\"$node\", gpu=~\"$gpu\"}",
