    {
      "type": "timeseries",
      "title": "RESIDENT BUT IDLE \u2014 the must-not-evict signal",
      "description": "Weights loaded and waiting read as 0% util. Any scheduler that treats util as occupancy will happily evict a warm model and pay the reload. VRAM is the only signal that reads this correctly \u2014 which is why it, not util, is the right basis for a multi-tenant admission decision.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
