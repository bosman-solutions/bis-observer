        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "color": "green"
                },
                "1": {
                  "text": "idle",
                  "color": "text"
                },
                "2": {
                  "text": "app clocks",
                  "color": "yellow"
                },
                "4": {
                  "text": "sw power cap",
                  "color": "orange"
                },
                "8": {
                  "text": "hw slowdown",
                  "color": "red"
                },
                "32": {
                  "text": "sw thermal",
                  "color": "orange"
                },
                "64": {
                  "text": "hw thermal",
                  "color": "red"
                },
                "128": {
                  "text": "hw power brake",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
