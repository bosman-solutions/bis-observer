        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * DCGM_FI_DEV_FB_USED{node=\"$node\", gpu=~\"$gpu\"} / clamp_min(DCGM_FI_DEV_FB_TOTAL{node=\"$node\", gpu=~\"$gpu\"}, 1)",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "stat",
