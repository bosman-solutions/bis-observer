{
  "uid": "bis-gpu-substrate",
  "title": "BIS \u2014 GPU / AI substrate",
  "tags": [
    "bis",
    "gpu",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 8,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      },
      {
        "name": "rate",
        "type": "textbox",
        "label": "$/kWh",
        "query": "0.16",
        "current": {
          "text": "0.16",
          "value": "0.16"
        },
        "options": []
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Node",
        "query": {
          "query": "label_values(DCGM_FI_DEV_FB_TOTAL, node)",
          "refId": "n"
        },
        "refresh": 2,
        "sort": 1,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "gpu",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "GPU",
        "query": {
          "query": "label_values(DCGM_FI_DEV_FB_TOTAL{node=\"$node\"}, gpu)",
          "refId": "g"
        },
        "refresh": 2,
        "sort": 1,
        "current": {},
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Card",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 3
      },
      "description": "Model as reported by the driver, with bus address and UUID.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_TOTAL{node=\"$node\", gpu=~\"$gpu\"}",
          "legendFormat": "{{modelName}}   \u00b7   gpu {{gpu}}   \u00b7   {{pci_bus_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "VRAM total",
      "description": "Framebuffer capacity of the selected card.",
