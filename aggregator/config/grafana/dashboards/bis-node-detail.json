{
  "uid": "bis-node-detail",
  "id": null,
  "title": "bis \u00b7 node detail",
  "description": "Everything about one hardware node: what it is, what it's doing, and what it's carrying. Linked from the identity card in the bis-starmap details drawer.",
  "tags": [
    "bis",
    "detail",
    "node"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "description": "Which Prometheus to read. Forks with a differently-named datasource pick it here instead of editing panel JSON."
      },
      {
        "name": "instance",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "instance-var"
        },
        "definition": "label_values(node_uname_info, instance)",
        "regex": "",
        "sort": 1,
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0,
        "description": "Every host reporting a node_exporter \u2014 bare metal and VMs alike. A VM is only distinguishable from iron here if something tells us so; there is no hypervisor exporter in this stack."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "IDENTITY",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "text",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_boot_time_seconds{instance=\"$instance\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "cores",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "text",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(node_cpu_seconds_total{instance=\"$instance\",mode=\"idle\"})",
          "legendFormat": "",
          "range": false,
