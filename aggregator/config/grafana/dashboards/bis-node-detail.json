          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{instance=\"$instance\"} - node_memory_MemAvailable_bytes{instance=\"$instance\"}",
          "legendFormat": "used",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes{instance=\"$instance\"}",
          "legendFormat": "available",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
