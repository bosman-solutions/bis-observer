    {
      "id": 7,
      "type": "table",
      "title": "kernel / os",
      "description": "Straight from node_exporter's uname/os info series \u2014 no inventory file to drift.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_uname_info{instance=\"$instance\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "node_os_info{instance=\"$instance\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "node": true,
              "domainname": true,
              "environment": true,
              "Value #A": true,
              "Value #B": true,
              "Value": true,
              "id": true,
              "id_like": true,
              "build_id": true,
              "image_id": true,
              "variant": true,
              "variant_id": true,
              "version_codename": true
            },
            "renameByName": {
              "nodename": "hostname",
              "sysname": "kernel",
              "release": "kernel release",
              "machine": "arch",
              "pretty_name": "os",
              "version": "kernel build"
            },
            "indexByName": {}
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "LOAD",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "cpu",
      "description": "100 minus idle, averaged across cores. The single number people mean by 'CPU'.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{instance=\"$instance\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "busy %",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "cpu by mode",
      "description": "Where the busy went. iowait climbing while user stays flat means the disk is the problem, not the CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by(mode)(rate(node_cpu_seconds_total{instance=\"$instance\",mode!=\"idle\"}[5m])) * 100",
          "legendFormat": "{{mode}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "load",
      "description": "Load normalised per core, so 1.0 means saturated regardless of core count. Comparable across a Pi Zero and a workstation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{instance=\"$instance\"} / count without(cpu,mode)(node_cpu_seconds_total{instance=\"$instance\",mode=\"idle\"})",
          "legendFormat": "1m",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "node_load5{instance=\"$instance\"} / count without(cpu,mode)(node_cpu_seconds_total{instance=\"$instance\",mode=\"idle\"})",
          "legendFormat": "5m",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "C",
          "expr": "node_load15{instance=\"$instance\"} / count without(cpu,mode)(node_cpu_seconds_total{instance=\"$instance\",mode=\"idle\"})",
          "legendFormat": "15m",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "memory",
      "description": "Available, not free \u2014 cache is reclaimable and counting it as used is the classic misread.",
