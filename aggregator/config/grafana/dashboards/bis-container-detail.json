{
  "uid": "bis-container-detail",
  "id": null,
  "title": "bis \u00b7 container detail",
  "description": "Everything about one container: what it is, what it's using, and how that reads against the host carrying it. Linked from the identity card in the bis-starmap details drawer.",
  "tags": [
    "bis",
    "detail",
    "container"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "description": "Which Prometheus to read. Forks with a differently-named datasource pick it here instead of editing panel JSON."
      },
      {
        "name": "node",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(docker_container_info, node)",
          "refId": "node-var"
        },
        "definition": "label_values(docker_container_info, node)",
        "regex": "",
        "sort": 1,
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0,
        "description": "The host the container runs on. Picked first \u2014 container names are only unique per host."
      },
      {
        "name": "container",
        "label": "container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(docker_container_info{node=\"$node\"}, name)",
          "refId": "container-var"
        },
        "definition": "label_values(docker_container_info{node=\"$node\"}, name)",
        "regex": "",
        "sort": 1,
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0,
        "description": "Chained to the host above, so the list only ever offers containers that actually exist there."
      },
      {
        "name": "stack",
        "label": "stack",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(docker_container_info{node=\"$node\",name=\"$container\"}, compose_project)",
          "refId": "stack-var"
        },
        "definition": "label_values(docker_container_info{node=\"$node\",name=\"$container\"}, compose_project)",
        "regex": "",
        "sort": 1,
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0,
        "description": "Derived from the selection \u2014 drives the siblings panel."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "IDENTITY",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "text",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - docker_container_started_at{node=\"$node\",name=\"$container\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "cpu now",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{node=\"$node\",name=\"$container\"}[5m]) * 100",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "memory now",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "text",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{node=\"$node\",name=\"$container\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "identity",
      "description": "From the Docker socket via docker-inventory. The image line is the honest answer to 'what is actually running' \u2014 tags lie, this is what the daemon reports.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docker_container_info{node=\"$node\",name=\"$container\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "exported_node": true,
              "environment": true,
              "Value": true
            },
            "renameByName": {
              "name": "container",
              "compose_project": "stack",
              "compose_service": "service",
              "image": "image",
              "state": "state",
              "node": "host"
            },
            "indexByName": {}
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "LOAD",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "cpu",
      "description": "Percent of one core. A value above 100 means the container is using more than a single core's worth, which is fine on a multi-core host and impossible on a Pi Zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{node=\"$node\",name=\"$container\"}[5m]) * 100",
          "legendFormat": "cpu %",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "memory",
      "description": "Working set is what the OOM killer looks at; usage includes reclaimable cache. The limit series only appears if one was set.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{node=\"$node\",name=\"$container\"}",
          "legendFormat": "working set",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "container_memory_usage_bytes{node=\"$node\",name=\"$container\"}",
          "legendFormat": "usage",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "C",
          "expr": "container_spec_memory_limit_bytes{node=\"$node\",name=\"$container\"} > 0",
          "legendFormat": "limit",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "share of host",
      "description": "The same load expressed as a fraction of everything the host has. This is the number that tells you whether one container is the reason a node is unhappy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(container_cpu_usage_seconds_total{node=\"$node\",name=\"$container\"}[5m]) * 100) / clamp_min(count(node_cpu_seconds_total{instance=\"$node\",mode=\"idle\"}), 1)",
          "legendFormat": "cpu % of host",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "(container_memory_working_set_bytes{node=\"$node\",name=\"$container\"} / clamp_min(node_memory_MemTotal_bytes{instance=\"$node\"}, 1)) * 100",
          "legendFormat": "memory % of host",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
