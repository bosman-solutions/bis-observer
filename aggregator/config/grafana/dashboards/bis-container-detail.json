    {
      "id": 13,
      "type": "timeseries",
      "title": "back pressure",
      "description": "Time the container spent waiting rather than running. CPU throttling only appears if a quota was set; the pressure series come from kernel PSI and are the earliest honest signal that something is starved.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
